# Production: PostgreSQL / Neon Free. Run sql/001-coordinator.sql first.
STORAGE_MODE=postgres
DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
APP_ORIGIN=https://totpbot.vercel.app
BOT_TOKEN=REPLACE_WITH_THE_SAME_BOTFATHER_TOKEN_USED_IN_BOTS_BUSINESS
CHANNEL_ID=-100REPLACE_WITH_CHANNEL_NUMERIC_ID
# Generate each independently with: openssl rand -hex 32
SERVER_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SETUP_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BB_FORWARD_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
CRON_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SESSION_IDLE_SECONDS=600
# Local-only synthetic development (never set these on Vercel):
# STORAGE_MODE=local-development
# APP_ORIGIN=http://127.0.0.1:3000
# LOCAL_STATE_PATH=work/vault.local
# LOCAL_MOCK_TELEGRAM=true
